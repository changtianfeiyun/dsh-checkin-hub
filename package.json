{
  "name": "dsh-checkin-hub",
  "version": "1.2.0",
  "type": "module",
  "description": "Sidebar check-in hub for WorkBuddy, Trae, Qoder and MiniMax Code credits, with a daily auto check-in scheduler",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "pack": "node scripts/pack.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "checkin",
    "check-in",
    "credits",
    "workbuddy",
    "trae",
    "qoder",
    "minimax",
    "scheduler",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changtianfeiyun/dsh-checkin-hub.git"
  },
  "homepage": "https://github.com/changtianfeiyun/dsh-checkin-hub#readme",
  "bugs": {
    "url": "https://github.com/changtianfeiyun/dsh-checkin-hub/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
